{
  "name": "WWTP Energy Performance",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
  "foreground": "#0b0b0b",
  "foregroundNeutralSecondary": "#52514e",
  "foregroundNeutralTertiary": "#898781",
  "background": "#fcfcfb",
  "backgroundLight": "#f9f9f7",
  "backgroundNeutral": "#e1e0d9",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#104281",
  "center": "#f0efec",
  "minimum": "#e34948",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0b0b0b" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#0b0b0b" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 9, "color": "#52514e" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#0b0b0b" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#fcfcfb" } }, "transparency": 0 }],
        "border":     [{ "show": true, "color": { "solid": { "color": "#e1e0d9" } }, "radius": 8 }],
        "visualHeader": [{ "show": true }],
        "valueAxis":    [{ "gridlineColor": { "solid": { "color": "#e1e0d9" } }, "gridlineThickness": 1 }]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#f9f9f7" } }, "transparency": 0 }] }
    }
  }
}
